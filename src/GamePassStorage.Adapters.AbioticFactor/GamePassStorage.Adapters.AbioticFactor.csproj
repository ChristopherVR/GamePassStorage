<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Abiotic Factor game adapter. It references only the GamePassStorage library. It ships built
    into the wgs tool and as its own package, and the same DLL also loads as a plugin
    (the tool's adapters folder option). To add another game, copy this project's layout as
    src/GamePassStorage.Adapters.<Game> (see docs/guide/adapter.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GamePassStorage.Adapters.AbioticFactor</RootNamespace>
    <AssemblyName>GamePassStorage.Adapters.AbioticFactor</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <IsPackable>true</IsPackable>
    <PackageId>GamePassStorage.Adapters.AbioticFactor</PackageId>
    <Title>Abiotic Factor adapter for GamePassStorage</Title>
    <Description>Game adapter for Abiotic Factor's Game Pass saves: classifies containers, reads a world bundle's table of contents without decompressing it, decodes the settings ini, names orphaned worlds and refuses writes while the game runs.</Description>
    <PackageTags>xbox;game-pass;connected-storage;wgs;abiotic-factor;save-editor;game-adapter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\GamePassStorage\GamePassStorage.csproj" />
  </ItemGroup>

</Project>
